# ------------------------------------------------------------------
# Degen Radar V1 — environment configuration
# Copy to .env and fill in. NEVER commit real secrets.
# ------------------------------------------------------------------

# Core
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

# Infrastructure (optional locally — the app boots in degraded mode without them)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/degen_radar
REDIS_URL=redis://localhost:6379

# Telegram (required to run the bot)
TELEGRAM_BOT_TOKEN=

# Solana (real security/authority checks require an RPC URL)
SOLANA_RPC_URL=
SOLANA_WS_URL=

# Providers
FOMO_API_KEY=
FOMO_BASE_URL=https://api.fomoapi.io
FOMO_WS_URL=wss://api.fomoapi.io/ws/alerts
X_BEARER_TOKEN=
X_BASE_URL=https://api.x.com
BIRDEYE_API_KEY=
BIRDEYE_BASE_URL=https://public-api.birdeye.so
DEXSCREENER_BASE_URL=https://api.dexscreener.com

# Market universe defaults
SCAN_MIN_MC=10000
SCAN_MAX_MC=70000
MIN_LIQUIDITY_USD=8000

# Alert defaults
ALERT_SCORE_THRESHOLD=75
ALERT_CONFIDENCE_THRESHOLD=70
CONVERGENCE_WINDOW_SECONDS=900
CONVERGENCE_MIN_ENTITIES=2
MAX_ALERTS_PER_HOUR=5
TOKEN_ALERT_COOLDOWN_SECONDS=900

# Feature flags
X_SEARCH_ENABLED=true
FOMO_ENABLED=true
BIRDEYE_ENABLED=true
DISCOVERY_ENABLED=true

# Development-only: use deterministic in-repo mock adapters instead of real
# provider HTTP calls. NEVER enable in production.
USE_MOCK_PROVIDERS=false
